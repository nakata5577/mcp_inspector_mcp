{
    "mcpServers": {
        "docs-rs": {
            "command": "npx",
            "args": [
                "-y",
                "@nuskey8/docs-rs-mcp"
            ],
            "env": {}
        },
        "serena": {
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/oraios/serena",
                "serena",
                "start-mcp-server",
                "--context",
                "ide-assistant",
                "--project",
                "$(pwd)",
                "--enable-web-dashboard=false"
            ],
            "env": {}
        },
        "mcp-inspector": {
            "command": "C:\\Users\\takah\\work\\my_mcp_server\\mcp_inspector_mcp\\target\\release\\mcp_inspector_mcp.exe",
            "args": [
                "--server",
                "technical-analysis:stdio:C:\\Users\\takah\\work\\my_mcp_server\\mcp_inspector_mcp\\technical_analysis.exe",
                "--log-backend",
                "memory"
            ]
        }
    }
}